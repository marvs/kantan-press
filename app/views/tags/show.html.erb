<% content_for :title, "Tagged #{@tag.name}" %>

<h1 class="page-heading">Tagged &ldquo;<%= @tag.name %>&rdquo;</h1>

<% if @posts.any? %>
  <div class="post-list">
    <%= render partial: "posts/summary", collection: @posts, as: :post %>
  </div>
<% else %>
  <p class="empty">Nothing with this tag yet.</p>
<% end %>
