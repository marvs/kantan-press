<% content_for :title, "Posts" %>

<div class="admin-head">
  <h1>Posts</h1>
  <%= link_to "New post", new_admin_post_path, class: "btn" %>
</div>

<div class="filters">
  <%= link_to "All (#{@counts.values.sum})", admin_posts_path,
        class: params[:status].blank? ? "active" : nil %>
  <% Post.statuses.each_key do |status| %>
    <%= link_to "#{status.humanize} (#{@counts.fetch(status, 0)})",
          admin_posts_path(status: status),
          class: params[:status] == status ? "active" : nil %>
  <% end %>

  <%= form_with url: admin_posts_path, method: :get, class: "filter-search" do |form| %>
    <%= form.hidden_field :status, value: params[:status] %>
    <%= form.text_field :q, value: params[:q], placeholder: "Search titles…" %>
  <% end %>
</div>

<% if @posts.any? %>
  <table class="index">
    <thead>
      <tr>
        <th>Title</th>
        <th>Status</th>
        <th>Categories</th>
        <th>Published</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @posts.each do |post| %>
        <tr>
          <td>
            <%= link_to post.title, edit_admin_post_path(post) %>
            <% if post.type_page? %><span class="pill pill-draft">Page</span><% end %>
            <div class="muted mono">/<%= post.slug %></div>
          </td>
          <td><%= status_pill(post.status) %></td>
          <td class="muted"><%= post.categories.map(&:name).join(", ").presence || "—" %></td>
          <td class="muted">
            <%= post.published_at ? l(post.published_at.to_date, format: :long) : "—" %>
          </td>
          <td>
            <div class="row-actions">
              <% if post.published? %>
                <%= link_to "View", post_path(post.slug), class: "btn btn-secondary btn-small",
                      target: "_blank", rel: "noopener" %>
                <%= button_to "Unpublish", unpublish_admin_post_path(post), method: :patch,
                      class: "btn btn-secondary btn-small" %>
              <% else %>
                <%= button_to "Publish", publish_admin_post_path(post), method: :patch,
                      class: "btn btn-small" %>
              <% end %>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <div class="card"><div class="card-body empty">
    No posts yet. <%= link_to "Import a WordPress export", new_admin_import_path %> or
    <%= link_to "write one", new_admin_post_path %>.
  </div></div>
<% end %>
