<%= form_with model: [ :admin, post ] do |form| %>
  <% if post.errors.any? %>
    <div class="errors">
      <strong><%= pluralize(post.errors.count, "problem") %> stopped this from saving:</strong>
      <ul>
        <% post.errors.full_messages.each do |message| %><li><%= message %></li><% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= form.label :title %>
    <%= form.text_field :title, placeholder: "Post title", class: "title-field" %>
  </div>

  <%# The editor needs the full width of the page: it renders its own toolbar
      and popovers, which collide with anything sharing the row. Post metadata
      therefore sits below rather than alongside. %>
  <div class="field">
    <%= form.label :content, "Content" %>

    <%# wp.attachEditor hides this and inserts the editor immediately after it,
        writing serialised block markup back into it on every change. %>
    <%= form.text_area :content, class: "content-editor", spellcheck: false, id: "post_content" %>

    <div class="block-editor-placeholder" data-editor-placeholder>Loading the editor…</div>

    <p class="hint">
      WordPress block markup, stored and served verbatim — imported posts keep
      byte-for-byte fidelity on blocks you don't touch.
      <a href="#" data-toggle-source>Edit as source</a>
    </p>
  </div>

  <div class="post-meta-grid">
    <div class="card">
      <div class="card-head">Publishing</div>
      <div class="card-body">
        <div class="field">
          <%= form.label :status %>
          <%= form.select :status, Post.statuses.keys.map { |s| [ s.humanize, s ] } %>
        </div>
        <div class="field">
          <%= form.label :post_type, "Type" %>
          <%= form.select :post_type, Post.post_types.keys.map { |t| [ t.humanize, t ] } %>
        </div>
        <div class="field">
          <%= form.label :published_at, "Publish date" %>
          <%= form.datetime_field :published_at %>
        </div>
        <div class="field">
          <%= form.label :slug %>
          <%= form.text_field :slug, placeholder: "generated-from-title" %>
          <p class="hint">Changing this breaks existing links unless you add a redirect.</p>
        </div>
      </div>
    </div>

    <div class="card">
      <div class="card-head">Taxonomy</div>
      <div class="card-body">
        <div class="field">
          <%= form.label :category_ids, "Categories" %>
          <%= form.collection_select :category_ids, Category.alphabetical, :id, :name, {}, multiple: true %>
        </div>
        <div class="field">
          <%= form.label :tag_ids, "Tags" %>
          <%= form.collection_select :tag_ids, Tag.alphabetical, :id, :name, {}, multiple: true %>
        </div>
      </div>
    </div>

    <div class="card">
      <div class="card-head">Featured image &amp; excerpt</div>
      <div class="card-body">
        <div class="field">
          <%= form.collection_select :featured_media_item_id,
                MediaItem.stored.recent.limit(200), :id, :filename,
                { include_blank: "No featured image" } %>
        </div>
        <% if post.featured_media_item&.stored? %>
          <%= image_tag post.featured_media_item.url, loading: "lazy",
                style: "width:100%;height:auto;border-radius:3px;margin-bottom:0.75rem" %>
        <% end %>
        <div class="field">
          <%= form.label :excerpt %>
          <%= form.text_area :excerpt, rows: 3 %>
          <p class="hint">Left blank, the body is trimmed instead.</p>
        </div>
      </div>
    </div>
  </div>

  <div class="admin-head" style="margin-top:1.5rem">
    <div>
      <%= form.submit post.persisted? ? "Save post" : "Create post", class: "btn" %>
      <% if post.persisted? && post.published? %>
        <%= link_to "View", post_path(post.slug), class: "btn btn-secondary", target: "_blank", rel: "noopener" %>
      <% end %>
    </div>
    <% if post.persisted? %>
      <%= button_to "Delete", admin_post_path(post), method: :delete,
            class: "btn btn-danger",
            form: { data: { turbo_confirm: "Delete “#{post.title}” permanently?" } } %>
    <% end %>
  </div>
<% end %>
