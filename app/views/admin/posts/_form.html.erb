<%= form_with model: [ :admin, post ] do |form| %>
  <% if post.errors.any? %>
    <div class="errors">
      <strong><%= pluralize(post.errors.count, "problem") %> stopped this from saving:</strong>
      <ul>
        <% post.errors.full_messages.each do |message| %><li><%= message %></li><% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= form.label :title %>
    <%= form.text_field :title, placeholder: "Post title", class: "title-field" %>
  </div>

  <%# The editor needs the full width of the page: it renders its own toolbar
      and popovers, which collide with anything sharing the row. Post metadata
      therefore sits below rather than alongside. %>
  <div class="field">
    <%= form.label :content, "Content" %>

    <%# wp.attachEditor hides this and inserts the editor immediately after it,
        writing serialised block markup back into it on every change. %>
    <%= form.text_area :content, class: "content-editor", spellcheck: false, id: "post_content" %>

    <div class="block-editor-placeholder" data-editor-placeholder>Loading the editor…</div>

    <p class="hint">
      WordPress block markup, stored and served verbatim — imported posts keep
      byte-for-byte fidelity on blocks you don't touch.
      <a href="#" data-toggle-source>Edit as source</a>
    </p>
  </div>

  <div class="post-meta-grid">
    <div class="card">
      <div class="card-head">Publishing</div>
      <div class="card-body">
        <div class="field">
          <%= form.label :status %>
          <%= form.select :status, Post.statuses.keys.map { |s| [ s.humanize, s ] } %>
        </div>
        <div class="field">
          <%= form.label :post_type, "Type" %>
          <%= form.select :post_type, Post.post_types.keys.map { |t| [ t.humanize, t ] } %>
        </div>
        <div class="field">
          <%= form.label :published_at, "Publish date" %>
          <%= form.datetime_field :published_at %>
        </div>
        <div class="field">
          <%= form.label :slug %>
          <%= form.text_field :slug, placeholder: "generated-from-title" %>
          <p class="hint">Changing this breaks existing links unless you add a redirect.</p>
        </div>
      </div>
    </div>

    <div class="card">
      <div class="card-head">Taxonomy</div>
      <div class="card-body">
        <div class="field">
          <%= form.label :category_ids, "Categories" %>
          <div class="check-list">
            <%= form.collection_check_boxes :category_ids, selected_first(Category.alphabetical, post.category_ids), :id, :name do |b| %>
              <label class="check-item"><%= b.check_box %> <%= b.text %></label>
            <% end %>
          </div>
        </div>

        <div class="field">
          <%= form.label :tag_ids, "Tags" %>
          <div class="check-list">
            <% if Tag.exists? %>
              <%= form.collection_check_boxes :tag_ids, selected_first(Tag.alphabetical, post.tag_ids), :id, :name do |b| %>
                <label class="check-item"><%= b.check_box %> <%= b.text %></label>
              <% end %>
            <% else %>
              <p class="empty" style="margin:0">No tags yet.</p>
            <% end %>
          </div>
        </div>

        <div class="field">
          <%= label_tag "post_new_tag_names", "Add new tags" %>
          <%= text_field_tag "post[new_tag_names]", nil, id: "post_new_tag_names",
                placeholder: "comma, separated" %>
          <p class="hint">Created and attached on save.</p>
        </div>
      </div>
    </div>

    <div class="card">
      <div class="card-head">Featured image</div>
      <div class="card-body">
        <div class="media-picker" data-media-picker>
          <div class="media-current">
            <% if post.featured_media_item&.stored? %>
              <%= image_tag post.featured_media_item.url, loading: "lazy",
                    alt: post.featured_media_item.alt_text.to_s, data: { media_preview: true } %>
              <div class="muted mono"><%= post.featured_media_item.filename %></div>
            <% else %>
              <div class="media-empty" data-media-preview-empty>No featured image</div>
            <% end %>
          </div>

          <div class="field">
            <%= form.label :featured_image, "Upload a new image" %>
            <%= form.file_field :featured_image, accept: "image/*" %>
            <p class="hint">Goes to the same bucket and key scheme as imported media.</p>
          </div>

          <div class="field">
            <%= label_tag "media-filter", "Or choose an existing one" %>
            <%= text_field_tag "media-filter", nil, placeholder: "Filter by filename…",
                  data: { media_filter: true }, autocomplete: "off" %>
          </div>

          <div class="media-grid" data-media-grid>
            <label class="media-option">
              <%= form.radio_button :featured_media_item_id, "" %>
              <span class="media-none">None</span>
            </label>

            <% MediaItem.stored.recent.limit(300).each do |item| %>
              <label class="media-option" data-filename="<%= item.filename.downcase %>">
                <%= form.radio_button :featured_media_item_id, item.id %>
                <%= image_tag item.url, loading: "lazy", alt: item.alt_text.to_s,
                      title: item.filename %>
              </label>
            <% end %>
          </div>
        </div>
      </div>
    </div>

    <div class="card">
      <div class="card-head">Excerpt</div>
      <div class="card-body">
        <div class="field">
          <%= form.text_area :excerpt, rows: 6, class: "excerpt-editor", spellcheck: false %>
          <p class="hint">
            HTML is allowed and rendered as-is on the index and in the feed.
            Left blank, the body is trimmed instead.
          </p>
        </div>
      </div>
    </div>
  </div>

  <div class="admin-head" style="margin-top:1.5rem">
    <div>
      <%= form.submit post.persisted? ? "Save post" : "Create post", class: "btn" %>
      <% if post.persisted? && post.published? %>
        <%= link_to "View", post_path(post.slug), class: "btn btn-secondary", target: "_blank", rel: "noopener" %>
      <% end %>
    </div>
    <% if post.persisted? %>
      <%= button_to "Delete", admin_post_path(post), method: :delete,
            class: "btn btn-danger",
            form: { data: { turbo_confirm: "Delete “#{post.title}” permanently?" } } %>
    <% end %>
  </div>
<% end %>
