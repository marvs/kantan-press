<% content_for :title, "#{@bundle.name} settings" %>

<div class="admin-head">
  <h1><%= @bundle.name %> settings</h1>
  <%= link_to "Back to themes", admin_themes_path, class: "btn btn-secondary" %>
</div>

<div class="row">
  <div class="main">
    <div class="card">
      <div class="card-head">Settings</div>
      <div class="card-body">
        <% if @theme.errors.any? %>
          <div class="field" style="color:var(--danger);font-size:0.88rem">
            <ul style="margin:0;padding-left:1.1rem">
              <% @theme.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <% if @bundle.settings_schema.any? %>
          <%= form_with url: admin_theme_path(@bundle.slug), method: :patch do |form| %>
            <% values = @theme.settings_with_defaults %>
            <% @bundle.settings_schema.each do |setting| %>
              <%= render "setting_field", setting: setting, value: values[setting.key] %>
            <% end %>

            <%= form.submit "Save settings", class: "btn" %>
          <% end %>

          <%= button_to "Reset to defaults", admin_theme_path(@bundle.slug), method: :patch,
                params: { reset: "1" }, class: "btn btn-secondary btn-small",
                form: { style: "margin-top:0.75rem" } %>
        <% else %>
          <p class="empty" style="margin:0">This theme declares no settings.</p>
        <% end %>
      </div>
    </div>
  </div>

  <div class="side">
    <div class="card">
      <div class="card-head">About this theme</div>
      <div class="card-body" style="font-size:0.86rem;line-height:1.6">
        <p style="margin-top:0">
          <strong><%= @bundle.name %></strong> <%= @bundle.version %><br>
          <% if @bundle.author.present? %>
            <% if @bundle.author_url.present? %>
              <%= link_to @bundle.author, @bundle.author_url, rel: "noopener noreferrer", target: "_blank" %>
            <% else %>
              <%= @bundle.author %>
            <% end %>
          <% end %>
        </p>
        <% if @bundle.description.present? %>
          <p style="margin-bottom:0"><%= @bundle.description %></p>
        <% end %>
      </div>
    </div>
  </div>
</div>
