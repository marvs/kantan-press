<% content_for :title, "Media" %>

<div class="admin-head">
  <h1>Media</h1>
  <% if @counts.fetch("failed", 0).positive? %>
    <%= button_to "Retry #{@counts['failed']} failed", retry_all_failed_admin_media_items_path,
          class: "btn" %>
  <% end %>
</div>

<div class="stat-grid" style="margin-bottom:1.25rem">
  <div class="stat"><div class="n"><%= @counts.values.sum %></div><div class="k">Total</div></div>
  <div class="stat"><div class="n"><%= @counts.fetch("stored", 0) %></div><div class="k">Stored</div></div>
  <div class="stat"><div class="n"><%= @counts.fetch("pending", 0) %></div><div class="k">Pending</div></div>
  <div class="stat"><div class="n"><%= @counts.fetch("failed", 0) %></div><div class="k">Failed</div></div>
</div>

<div class="filters">
  <%= link_to "All", admin_media_items_path, class: params[:status].blank? ? "active" : nil %>
  <% MediaItem.statuses.each_key do |status| %>
    <%= link_to "#{status.humanize} (#{@counts.fetch(status, 0)})",
          admin_media_items_path(status: status),
          class: params[:status] == status ? "active" : nil %>
  <% end %>
</div>

<% if @media_items.any? %>
  <table class="index">
    <thead>
      <tr><th></th><th>Key</th><th>Status</th><th>Size</th><th>Dimensions</th><th></th></tr>
    </thead>
    <tbody>
      <% @media_items.each do |item| %>
        <tr>
          <td>
            <% if item.stored? && item.image? %>
              <%= image_tag item.url, class: "thumb", loading: "lazy", alt: item.alt_text.to_s %>
            <% else %>
              <div class="thumb"></div>
            <% end %>
          </td>
          <td>
            <div class="mono"><%= item.key %></div>
            <% if item.fetch_error.present? %>
              <div class="muted" style="color:var(--danger)"><%= truncate(item.fetch_error, length: 120) %></div>
            <% end %>
          </td>
          <td><%= status_pill(item.status) %></td>
          <td class="numeric muted"><%= item.byte_size ? number_to_human_size(item.byte_size) : "—" %></td>
          <td class="muted"><%= item.dimensions || "—" %></td>
          <td>
            <% unless item.stored? %>
              <%= button_to "Retry", retry_fetch_admin_media_item_path(item), class: "btn btn-secondary btn-small" %>
            <% end %>
            <%= button_to "Delete", admin_media_item_path(item), method: :delete,
                  class: "btn btn-danger btn-small",
                  form: { data: { turbo_confirm: "Delete #{item.filename}?" } } %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <div class="card"><div class="card-body empty">
    No media yet. Images arrive automatically when you
    <%= link_to "import a WordPress export", new_admin_import_path %>.
  </div></div>
<% end %>
