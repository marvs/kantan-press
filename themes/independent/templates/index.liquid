{%- comment -%}
  The masthead is typographic: the site's name set large, its tagline under it,
  and the categories with how much is in each. No hero image.

  On the first page the newest post gets a larger card than the rest, so the
  reason a returning reader came back is the first thing they see. Page two
  onwards has no "latest", so every entry there is an ordinary card.
{%- endcomment -%}

<header class="site-header">
  <div class="wrap">
    <p class="site-title"><a href="{{ site.url }}">{{ site.title }}</a></p>
    {% if site.description != blank %}<p class="site-description">{{ site.description }}</p>{% endif %}

    <nav class="site-nav">
      {%- for category in site.categories %}
        <a href="{{ category.url }}">{{ category.name }} <span class="site-nav__count">{{ category.post_count }}</span></a>
      {%- endfor %}
    </nav>
  </div>
</header>

<main class="site-main">
  <div class="wrap">
    {% if posts.size > 0 %}
      {% assign lead = posts.first %}
      {% if pagination.current_page == 1 %}
        <article class="post-lead">
          {% if lead.featured_image %}
            <a class="post-lead__thumb" href="{{ lead.url }}" aria-hidden="true" tabindex="-1">
              <img src="{{ lead.featured_image.url }}" alt="" fetchpriority="high" decoding="async">
            </a>
          {% endif %}

          <div class="post-lead__text">
            <p class="post-lead__eyebrow">
              Latest{% if lead.categories.size > 0 %} in {{ lead.categories.first.name }}{% endif %}
            </p>
            <h2 class="entry-title"><a href="{{ lead.url }}">{{ lead.title }}</a></h2>

            <div class="entry-meta">
              {%- if lead.published_at %}<span>{{ lead.published_at | date: "%B %-d, %Y" }}</span>{% endif -%}
              {%- if lead.word_count > 0 %}<span>{{ lead.word_count | number_with_delimiter }} words</span>{% endif -%}
            </div>

            <p class="post-lead__excerpt">{{ lead.excerpt_html }}</p>
            <a class="more-link" href="{{ lead.url }}">Continue reading &rarr;</a>
          </div>
        </article>
      {% endif %}

      <div class="post-list">
        {% if pagination.current_page == 1 %}{% assign start = 1 %}{% else %}{% assign start = 0 %}{% endif %}
        {% for post in posts offset: start %}
          <article class="post-summary">
            {%- comment -%}
              One plate for every entry. When the post has a cover the image sits
              behind a darkened field with the date stamped over it; when it has
              none the same plate carries the date on tint. That is what keeps an
              image-less post from reading as a hole in the column.

              aria-hidden because the title beside it links to the same post: a
              screen reader or a keyboard user should meet one link per entry.
            {%- endcomment -%}
            <a class="post-summary__plate{% if post.featured_image %} post-summary__plate--photo{% endif %}"
               href="{{ post.url }}" aria-hidden="true" tabindex="-1">
              {% if post.featured_image %}
                <img src="{{ post.featured_image.url }}" alt="" loading="lazy" decoding="async">
              {% endif %}
              {% if post.published_at %}
                <span class="dateline">
                  <span class="dateline__month">{{ post.published_at | date: "%b" }}</span>
                  <span class="dateline__year">{{ post.published_at | date: "%Y" }}</span>
                </span>
              {% endif %}
            </a>

            <div class="post-summary__text">
              <h2 class="entry-title"><a href="{{ post.url }}">{{ post.title }}</a></h2>

              <div class="entry-meta">
                {%- if post.published_at %}<span>{{ post.published_at | date: "%B %-d, %Y" }}</span>{% endif -%}
                {%- if post.categories.size > 0 -%}
                  <span>
                    {%- for category in post.categories %}
                      <a href="{{ category.url }}">{{ category.name }}</a>{% unless forloop.last %},{% endunless %}
                    {%- endfor -%}
                  </span>
                {%- endif -%}
              </div>

              <p class="post-summary__excerpt">{{ post.excerpt_html }}</p>
              <a class="more-link" href="{{ post.url }}">Continue reading &rarr;</a>
            </div>
          </article>
        {% endfor %}
      </div>

      {% if pagination.total_pages > 1 %}
        <nav class="pagination">
          <span>{% if pagination.previous_url %}<a href="{{ pagination.previous_url }}">&larr; Newer</a>{% endif %}</span>
          <span class="pagination__page">Page {{ pagination.current_page }} of {{ pagination.total_pages }}</span>
          <span>{% if pagination.next_url %}<a href="{{ pagination.next_url }}">Older &rarr;</a>{% endif %}</span>
        </nav>
      {% endif %}
    {% else %}
      <p class="empty">Nothing published yet.</p>
    {% endif %}
  </div>
</main>
