{%- comment -%}
  A single post. The title lives inside the cover image when there is one, and
  falls back to an ordinary header when there is not — otherwise a post with no
  featured image would open on a black band.
{%- endcomment -%}

{%- capture byline -%}
  {%- if post.author_name != blank %}<span>{{ post.author_name }}</span>{% endif -%}
  {%- if post.categories.size > 0 -%}
    <span>in
      {%- for category in post.categories %}
        <a href="{{ category.url }}">{{ category.name }}</a>{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    </span>
  {%- endif -%}
  {%- if post.published_at %}<span>{{ post.published_at | date: "%B %-d, %Y" }}</span>{% endif -%}
  {%- if settings.show_word_count and post.word_count > 0 -%}
    <span>{{ post.word_count | number_with_delimiter }} Words</span>
  {%- endif -%}
{%- endcapture -%}

{% if post.featured_image %}
  <div class="post-cover">
    <img class="post-cover__image" src="{{ post.featured_image.url }}" alt="{{ post.featured_image.alt }}"
         fetchpriority="high" decoding="async">
    <div class="post-cover__scrim"></div>
    <a class="post-cover__home" href="{{ site.url }}" aria-label="{{ site.title }}">&#8962;</a>

    <div class="cover-meta">
      <h1 class="entry-title">{{ post.title }}</h1>
      <div class="entry-meta">{{ byline }}</div>
    </div>
  </div>
{% else %}
  <header class="site-header">
    <div class="wrap">
      <p class="site-title"><a href="{{ site.url }}">{{ site.title }}</a></p>
    </div>
  </header>
{% endif %}

<main class="site-main">
  <article class="wrap">
    {% unless post.featured_image %}
      <header class="entry-header">
        <h1 class="entry-title">{{ post.title }}</h1>
        <div class="entry-meta">{{ byline }}</div>
      </header>
    {% endunless %}

    <div class="entry-content">{{ post.body_html }}</div>

    {% if post.tags.size > 0 %}
      <footer class="entry-footer">
        Tagged
        {%- for tag in post.tags %}
          <a href="{{ tag.url }}">{{ tag.name }}</a>{% unless forloop.last %},{% endunless %}
        {%- endfor %}
      </footer>
    {% endif %}

    {% if post.comment_count > 0 %}
      <section class="comments">
        <h2 class="comments__title">
          {{ post.comment_count }} comment{% unless post.comment_count == 1 %}s{% endunless %}
        </h2>

        {% for comment in post.comments %}
          <div class="comment{% if comment.reply %} is-reply{% endif %}">
            <div class="comment__meta">
              <strong>
                {%- if comment.author_url != blank -%}
                  <a href="{{ comment.author_url }}" rel="nofollow noopener">{{ comment.author_name }}</a>
                {%- else -%}
                  {{ comment.author_name }}
                {%- endif -%}
              </strong>
              {% if comment.published_at %}· {{ comment.published_at | date: "%B %-d, %Y" }}{% endif %}
            </div>
            <div class="comment__body">{{ comment.content_html }}</div>
          </div>
        {% endfor %}
      </section>
    {% endif %}
  </article>
</main>
