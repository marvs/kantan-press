{%- comment -%}
  Shared by category, tag and month archives. The controller passes the heading
  in archive.title, so this template does not need to know which it is.
{%- endcomment -%}

<header class="site-header">
  <div class="wrap">
    <p class="site-title"><a href="{{ site.url }}">{{ site.title }}</a></p>

    <nav class="site-nav">
      {%- for category in site.categories limit: 8 %}
        <a href="{{ category.url }}">{{ category.name }}</a>
      {%- endfor %}
    </nav>
  </div>
</header>

<main class="site-main">
  <div class="wrap">
    <header class="page-header">
      <h1 class="page-title">{{ archive.title }}</h1>
      {% if archive.description != blank %}
        <p class="page-description">{{ archive.description }}</p>
      {% endif %}
    </header>

    {% if posts.size > 0 %}
      <div class="post-list">
        {% for post in posts %}
          <article class="post-summary">
            {% if post.featured_image %}
              {%- comment -%}
                aria-hidden because the title right next to it links to the same
                post: a screen reader or a keyboard user should meet one link
                per entry, not two.
              {%- endcomment -%}
              <a class="post-summary__thumb" href="{{ post.url }}" aria-hidden="true" tabindex="-1">
                <img src="{{ post.featured_image.url }}" alt="" loading="lazy" decoding="async">
              </a>
            {% endif %}

            <div class="post-summary__text">
              <h2 class="entry-title"><a href="{{ post.url }}">{{ post.title }}</a></h2>

              <div class="entry-meta">
                {%- if post.published_at %}<span>{{ post.published_at | date: "%B %-d, %Y" }}</span>{% endif -%}
              </div>

              <p class="post-summary__excerpt">{{ post.excerpt_html }}</p>
              <a class="more-link" href="{{ post.url }}">Continue reading &rarr;</a>
            </div>
          </article>
        {% endfor %}
      </div>
    {% else %}
      <p class="empty">Nothing published here yet.</p>
    {% endif %}
  </div>
</main>
