# Kantan Press configuration. Every value can also live in Rails credentials
# under a kantan_press: key; ENV wins when both are set.

# --- media ------------------------------------------------------------------

# The host that appears in post content for every image. Always a domain you
# control, never the raw bucket endpoint, so the CDN can be repointed later
# without rewriting posts. Leave unset in development to serve from public/media.
KANTAN_MEDIA_BASE_URL=https://cdn.example.com

# The site the WordPress export came from. The importer rewrites this host to
# KANTAN_MEDIA_BASE_URL in every <img src> and srcset. Read from the export's
# <wp:base_blog_url> when unset, which is usually correct.
KANTAN_LEGACY_SITE_URL=https://example.com

# --- object storage ---------------------------------------------------------

# "disk" writes to public/media (development default when S3 is unconfigured).
# "s3" targets any S3-compatible endpoint. Inferred from the values below when
# left unset.
KANTAN_STORAGE_BACKEND=s3

# Cloudflare R2: https://<account-id>.r2.cloudflarestorage.com
# AWS S3:        https://s3.<region>.amazonaws.com
# DO Spaces:     https://<region>.digitaloceanspaces.com
KANTAN_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
KANTAN_S3_BUCKET=kantan-press
KANTAN_S3_ACCESS_KEY_ID=
KANTAN_S3_SECRET_ACCESS_KEY=

# R2 wants "auto"; S3 and Spaces want their real region.
KANTAN_S3_REGION=auto

# --- first admin user (db:seed) ---------------------------------------------

KANTAN_ADMIN_EMAIL=you@example.com
KANTAN_ADMIN_PASSWORD=
